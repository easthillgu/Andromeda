-- Exclude third-party libraries
exclude_files = {
    "libraries/**/*.lua"
}

-- WoW-specific overrides
max_line_length = 200
max_code_line_length = 200
max_comment_line_length = 200

-- WoW callback patterns often have unused self/event args - keep as warnings not errors
unused_args = true

-- Allow WoW's common lowercase globals (Lua stdlib aliased by WoW)
allow_defined = true
